terraform {
  required_providers {
    random = {
      source = "hashicorp/random"
    }
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}
provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
# Project 3 - three-tier law-firm ERP (Terraform, generated by the Azure portal export and cleaned).
# EXPERIMENTAL: portal-generated, edited by hand, NOT tested with terraform plan/apply.
# Prefer the ARM template or Bicep in this folder.

variable "subscription_id" {
  type        = string
  description = "Your Azure subscription ID. Never commit a real value."
}

variable "location" {
  type    = string
  default = "eastus"
}

variable "resource_group_name" {
  type    = string
  default = "Project_3"
}

variable "admin_password" {
  type      = string
  sensitive = true
}

locals {
  tags = {
    project     = "project_3"
    owner       = "lab-owner"
    expires     = "YYYY-MM-DD"
    environment = "lab"
    purpose     = "az104-hands-on"
  }
}

resource "random_string" "suffix" {
  length  = 8
  upper   = false
  special = false
}

resource "azurerm_managed_disk" "db" {
  name                 = "vm-db_databasedisk"
  location             = var.location
  resource_group_name  = azurerm_resource_group.res-1.name
  storage_account_type = "StandardSSD_LRS"
  create_option        = "Empty"
  disk_size_gb         = 4
  zone                 = "1"
  tags                 = local.tags
}

resource "azurerm_linux_virtual_machine" "res-1" {
  admin_username                    = "azureuser"
  admin_password                    = var.admin_password
  disable_password_authentication   = false
  allow_extension_operations        = true
  computer_name                     = "vm-app"
  disk_controller_type              = "NVMe"
  location                          = var.location
  tags                         = local.tags
  name                              = "vm-app"
  network_interface_ids             = [azurerm_network_interface.res-1.id]
  patch_assessment_mode             = "ImageDefault"
  patch_mode                        = "ImageDefault"
  provision_vm_agent                = true
  resource_group_name               = azurerm_resource_group.res-1.name
  secure_boot_enabled               = true
  size                              = "Standard_D2s_v6"
  vm_agent_platform_updates_enabled = true
  vtpm_enabled                      = true
  zone                              = "2"
  additional_capabilities {
  }
  boot_diagnostics {
  }
  os_disk {
    caching              = "ReadWrite"
    disk_size_gb         = 30
    name                 = "vm-app_OsDisk_1_258a0cac515245d9b76852dc0414a925"
    storage_account_type = "Premium_LRS"
